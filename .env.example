SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_PORTAL_URL=http://localhost:8000/secure-admin/
USE_X_FORWARDED_HOST=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False
CERTIFICATE_VERIFICATION_URL=https://sureproed.com/certificate/verify/{code}

# Separate examination platform
EXAM_PLATFORM_URL=http://localhost:3000/exam
CORS_ALLOW_ALL_ORIGINS=False
CERTIFICATE_VERIFICATION_URL=https://sureproed.com/certificate/verify/{code}

# Separate examination platform
EXAM_PLATFORM_URL=http://localhost:3000/exam
EXAM_PLATFORM_SHARED_SECRET=generate-a-long-random-secret
EXAM_LAUNCH_TOKEN_TTL_SECONDS=300
EXAM_RESULT_MAX_CLOCK_SKEW_SECONDS=300
ALLOW_INTERNAL_EXAM_SUBMISSION=True
JITSI_DOMAIN=meet.jit.si

# Server-side AI Question Generation (Hybrid: Fast Groq Generator + Independent Gemini Verifier)
AI_GENERATOR_PROVIDER=groq
AI_GENERATOR_MODEL=openai/gpt-oss-120b
AI_GENERATOR_API_KEY=gsk_your_groq_api_key_here

AI_VERIFIER_PROVIDER=gemini
AI_VERIFIER_MODEL=gemini-3.6-flash
AI_VERIFIER_API_KEY=your_gemini_api_key_here
AI_VERIFIER_MIN_CONFIDENCE=0.80
AI_GEMINI_MIN_REQUEST_INTERVAL_SECONDS=4.2

# (Optional Backup: Hugging Face Serverless API - commented for now)
# AI_GENERATOR_PROVIDER=huggingface
# AI_GENERATOR_MODEL=meta-llama/Llama-3.3-70B-Instruct
# AI_GENERATOR_API_KEY=hf_your_token_here

AI_QUESTION_BANK_MAX_RETRIES=2
AI_QUESTION_BANK_RETRY_DELAY_MINUTES=10
FAILED_QUESTION_BANK_RETENTION_HOURS=1
USE_SQLITE=False
POSTGRES_DB=suretrust
POSTGRES_USER=suretrust
POSTGRES_PASSWORD=suretrust_password
POSTGRES_HOST=192.168.0.72
POSTGRES_PORT=5432
CONN_MAX_AGE=60

REDIS_URL=redis://127.0.0.1:6379/0
CHANNEL_LAYER_BACKEND=channels_redis.core.RedisChannelLayer
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Redis API/session cache (DB 2 is intentionally separate from Celery)
REDIS_CACHE_URL=redis://127.0.0.1:6379/2
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://127.0.0.1:6379/2
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=suretrust-api

# ZeptoMail SMTP Settings
EMAIL_HOST=smtp.zeptomail.in
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=your_zeptomail_send_mail_token_here
DEFAULT_FROM_EMAIL=noreply@sureproed.com
ZEPTOMAIL_API_TOKEN=your_zeptomail_send_mail_token_here

# API Rate Limiting & Throttling (Per Individual IP)
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# LinkedIn OAuth 2.0 Settings
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://api.sureproed.com/api/auth/linkedin/callback/

# Web page to return to after the backend completes GitHub account linking.
GITHUB_OAUTH_FRONTEND_URL=http://localhost:5173



# Android push: private credential JSON stays outside the repository.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
